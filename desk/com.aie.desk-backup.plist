<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly backup of the private desk data (posts, memos, scorecard) to the
  PRIVATE repo nainaii1/ai-desk-private, at 23:30 local time. If the Mac is
  asleep then, launchd runs it on wake.
  Install:   cp desk/com.aie.desk-backup.plist ~/Library/LaunchAgents/ &&
             launchctl load ~/Library/LaunchAgents/com.aie.desk-backup.plist
  Log:       ~/Library/Logs/desk-backup.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aie.desk-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
    <string>-u</string>
    <string>/Users/mikembp/Documents/Claude/ai-supply-desk/desk/backup.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/mikembp/Documents/Claude/ai-supply-desk/desk</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/mikembp/Library/Logs/desk-backup.log</string>
  <key>StandardErrorPath</key><string>/Users/mikembp/Library/Logs/desk-backup.log</string>
</dict>
</plist>
